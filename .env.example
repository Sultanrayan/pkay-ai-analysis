[TEMPLATE]
# ---- Telegram ---------------------------------------------------------------
# Get a token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Public HTTPS URL for webhook mode (production). Keep empty for polling mode.
TELEGRAM_WEBHOOK_URL=
# Local webhook server bind settings (webhook mode)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
# Webhook secret for signature verification (generate with: python -c "import secrets; print(secrets.token_hex(32))")
WEBHOOK_SECRET=your_webhook_secret_here

# ---- Public JSON API (v3) ---------------------------------------------------
# Comma-separated API keys accepted as "Authorization: Bearer <key>" by
# /api/v3/analyze and /api/v3/agents. Leave empty to run the API open (dev only;
# set keys in production).
PKAY_API_KEYS=

# ---- Google OAuth (public API sign-in / register) ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public auth base URL used to build the OAuth redirect URI.
# Redirect URI: {AUTH_BASE_URL}/api/v3/auth/google/callback
AUTH_BASE_URL=https://auth.pkay.fun
# Where the browser is sent after a successful sign-in.
FRONTEND_URL=
# Secret used to sign session tokens (falls back to the Google client secret).
SESSION_SECRET=
# Comma-separated allowed browser origins for CORS. Empty means allow any.
CORS_ORIGINS=https://developer.pkay.fun,http://localhost:5173

# ---- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql://tradingbot:tradingbot@localhost:5432/trading_bot
# ---- Cache / rate limiting (Redis) -----------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Bot defaults ----------------------------------------------------------
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1h
MAX_DAILY_REQUESTS=10
LOG_LEVEL=INFO
# Force the demo (offline) data provider instead of live APIs. Useful for
# development or air-gapped environments. Default: false
USE_DEMO_DATA=false
# Fail over to deterministic demo data whenever a live API call fails.
# Default: true
DEMO_FALLBACK=true

# ---- DeepSeek-V4-Flash (optional AI signal enrichment) ----------------------
# When set, the LLM reviews the agent consensus and produces the final signal,
# confidence and summary. Without a key (or on any API error) the bot uses the
# deterministic decision engine, so reports always work.
DEEPSEEK_API_KEY=
# DeepSeek model name (see https://platform.deepseek.com)
DEEPSEEK_MODEL=deepseek-v4-flash
# OpenAI-compatible API base URL. Override only if you proxy DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Per-request timeout in seconds. Default: 20
DEEPSEEK_TIMEOUT_SECONDS=20

# ---- Memecoin sniper (signal-only, never executes orders) -------------------
SNIPER_ENABLED=true
# Candidates below this liquidity (USD) are filtered out. Default: 500000
SNIPER_MIN_LIQUIDITY=500000
# Max opportunities shown per scan. Default: 3
SNIPER_MAX_OPPORTUNITIES=3

# ---- Charts ----------------------------------------------------------------
CHART_ENABLED=true
CHART_PATH=./charts

# ---- Sentiment data sources ------------------------------------------------
# Fear & Greed index endpoint (alternative.me). Override for testing.
FEAR_GREED_API_URL=https://api.alternative.me/fng/?limit=1
# RSS feeds scored for news sentiment (comma separated). When unset, the bot
# uses the per-asset defaults (CoinDesk for BTC, Google News for ETH/SOL/XAU).
NEWS_RSS_FEEDS=